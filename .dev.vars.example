# 复制为 .dev.vars 后填真实值。该文件已被 .gitignore 忽略。
# 生产环境不要用这个文件，用：npx wrangler secret put <NAME>

# 管理后台口令（签发 / 吊销用户 Key）
ADMIN_TOKEN=change-me-to-a-long-random-string

# 加密用户 MCP 密钥的主密钥：32 字节随机数，64 位十六进制。
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 没配置时，用户保存 MCP 密钥会被拒绝（不会明文存储）。生产用 wrangler secret put USER_SECRETS_KEY。
# 换这把 Key 会让已保存的用户密钥全部失效，需要用户重新填。
USER_SECRETS_KEY=

# PROVIDERS 里每个 id 对应一把 Key，例如 grok → GROK_API_KEY
GROK_API_KEY=
DEEPSEEK_API_KEY=
# OpenCode Go 订阅。不要填到 https://opencode.ai/zen/v1（那是按量另扣）
OPENCODE_API_KEY=

# grok 的 quota.secret / ${GROK_TEAM_ID}。推理 Key 不能查余额。
GROK_MANAGEMENT_KEY=
GROK_TEAM_ID=
