{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "my-sub-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-19",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  },
  // 上游 API Key / ADMIN_TOKEN 不要写在这里。用 wrangler secret put，本地用 .dev.vars。
  "vars": {
    "DEFAULT_PROVIDER": "opencode",
    // OpenCode Zen / Console：官方 OpenAI 兼容入口
    "OPENCODE_BASE_URL": "https://opencode.ai/zen/v1",
    // Cursor 官方没有公开的 /v1/chat/completions。填你已有的 OpenAI 兼容地址，没有就留空。
    "CURSOR_BASE_URL": "",
    // 额外上游，例如 [{"id":"openai","baseUrl":"https://api.openai.com/v1"}]
    // 对应 secret 名为 OPENAI_API_KEY（{ID}_API_KEY，ID 大写）
    // 同一 baseUrl 的多个 id 视为同厂商账号池，会轮询；429 换号，401/403 拉黑后换号
    "EXTRA_PROVIDERS": "[]",
    // 模型别名，例如 {"gpt-4":"opencode/gpt-5.4","composer":"cursor/composer-2.5"}
    "MODEL_ALIASES": "{}",
    // 签发使用者 Key 时的默认 token 额度，0 表示不限额
    "DEFAULT_QUOTA_TOKENS": "10000000"
  },
  "kv_namespaces": [
    { "binding": "KEYS" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "SESSIONS", "class_name": "ChatSession" },
      { "name": "QUOTAS", "class_name": "QuotaBoard" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ChatSession"] },
    { "tag": "v2", "new_sqlite_classes": ["QuotaBoard"] }
  ]
}
