{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "my-sub-api",
  "account_id": "faa48c4594352d235803143377d82d1f",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    { "pattern": "aofahub.dev", "custom_domain": true },
    { "pattern": "www.aofahub.dev", "custom_domain": true }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  },
  // 上游 API Key / ADMIN_TOKEN 不要写在这里。用 wrangler secret put，本地用 .dev.vars。
  "vars": {
    // 上游列表。对应 secret 为 {ID}_API_KEY
    // 同一 baseUrl 的多个 id 视为同厂商账号池，会轮询；429 换号，401/403 拉黑后换号
    "PROVIDERS": [{"id":"grok","baseUrl":"https://api.x.ai/v1"}],
    // 模型别名，例如 {"gpt-4":"opencode/gpt-5.4","composer":"cursor/composer-2.5"}
    "MODEL_ALIASES": {},
    // 签发使用者 Key 时的默认 token 额度，0 表示不限额
    "DEFAULT_QUOTA_TOKENS": "10000000"
  },
  "kv_namespaces": [
    { "binding": "KEYS" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "SESSIONS", "class_name": "ChatSession" },
      { "name": "QUOTAS", "class_name": "QuotaBoard" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ChatSession"] },
    { "tag": "v2", "new_sqlite_classes": ["QuotaBoard"] }
  ]
}
